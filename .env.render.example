DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-render-generated-secret
APP_BASE_PATH=
ALLOWED_HOSTS=.onrender.com,wingrootechnologies.com,www.wingrootechnologies.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://wingrootechnologies.com,https://www.wingrootechnologies.com
CORS_ALLOWED_ORIGINS=https://wingrootechnologies.com,https://www.wingrootechnologies.com
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.onrender\.com$

DATABASE_URL=postgres://user:password@host:5432/database
DB_CONN_MAX_AGE=600
DB_SSL_REQUIRE=true

STATIC_URL=/static/
MEDIA_URL=/media/

# Rules proof fallback: when no object storage is enabled, keep the original
# photo, signature, and signed PDF in the configured PostgreSQL database.
# Use a durable, backed-up production database; Free Render services are not a
# permanent document-storage solution.
USE_S3_STORAGE=false
RULES_DATABASE_FILE_BACKUPS=true
# Set this only after attaching a paid Render persistent disk and pointing
# MEDIA_ROOT inside its mount path; MEDIA_ROOT alone is not durable.
# RULES_PERSISTENT_MEDIA_ROOT=true

# Recommended production alternative: use a private durable S3-compatible
# bucket (AWS S3 or Cloudflare R2).  When USE_S3_STORAGE=true, all variables
# below except AWS_S3_CUSTOM_DOMAIN are required by the current settings.
# Never commit real values.
# USE_S3_STORAGE=true
# AWS_STORAGE_BUCKET_NAME=replace-with-private-bucket
# AWS_ACCESS_KEY_ID=replace-with-access-key
# AWS_SECRET_ACCESS_KEY=replace-with-secret
# AWS_S3_REGION_NAME=auto
# AWS_S3_ENDPOINT_URL=https://replace-with-provider-endpoint
# AWS_S3_ADDRESSING_STYLE=path
# AWS_S3_CUSTOM_DOMAIN=

WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
